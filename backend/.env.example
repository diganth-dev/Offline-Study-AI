# =========================================================
# Offline Study AI Backend Configuration
# =========================================================

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 256-bit cryptographically secure JWT signing key
JWT_SECRET_KEY=your-256-bit-jwt-secret-key-here

# =========================================================
# CORS Configuration (Allowed Origins)
# =========================================================
# Comma-separated list or JSON array of allowed frontend origins.
# Wildcard '*' is disallowed when allow_credentials=True.
# Production frontend origin & local Vite development servers:
ALLOWED_ORIGINS=https://offline-study-ai.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# =========================================================
# SMTP Email Configuration (for Password Reset Codes)
# =========================================================
# For Gmail:
# 1. Enable 2-Step Verification in Google Account Settings.
# 2. Go to myaccount.google.com/apppasswords.
# 3. Create an App Password for "Offline Study AI" (16 characters).
# 4. Paste your Gmail address and the 16-character App Password below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Offline Study AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
